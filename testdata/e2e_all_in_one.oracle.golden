SQL:
with active as (
    select id from acct where flag = :1
)
select p.id
from person p
join active a on a.id = p.id
where 1 = 1
and name = :2
and p.id in (:3, :4)


Args: []interface {}{true, "SCOTT", 1, 2}

SQLWithArgs:
with active as (
    select id from acct where flag = true
)
select p.id
from person p
join active a on a.id = p.id
where 1 = 1
and name = 'SCOTT'
and p.id in (1, 2)


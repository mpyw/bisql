SQL:
with active as (
    select id from acct where flag = ?
)
select p.id, p.name
from person p
join active a on a.id = p.id
where 1 = 1
and name = ?
and p.id in (?, ?)
order by name, id desc 


Args: []interface {}{true, "SCOTT", 1, 2}

SQLWithArgs:
with active as (
    select id from acct where flag = true
)
select p.id, p.name
from person p
join active a on a.id = p.id
where 1 = 1
and name = 'SCOTT'
and p.id in (1, 2)
order by name, id desc 

